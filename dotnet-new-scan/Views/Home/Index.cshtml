@model PathViewModel
@{
    ViewData["Title"] = "Recherche de chemin";
}

<p class="hint">
    <strong>Source :</strong> @Model.SourceDescription
</p>
<p class="hint">
    Vérifie s'il existe un chemin orienté entre deux nœuds, et affiche le plus
    court. Le formulaire est soumis en <code>GET</code> : l'URL du résultat est
    partageable. Le menu <em>Algorithme</em> choisit entre
    <strong>BFS bidirectionnel</strong>, <strong>Dijkstra</strong>,
    <strong>Dijkstra bidirectionnel</strong> et <strong>A*</strong> : les arêtes
    ayant toutes le même poids, les quatre renvoient le même chemin — seul le
    temps de calcul diffère. En mode SQL, les
    <a asp-controller="Scan" asp-action="Index">pré-calculs</a> (§ 11.4 / § 11.5)
    tranchent d'abord le « aucun chemin » sans parcours.
</p>

@* <form method="get"> : soumission HTML classique, la page se recharge avec
   ?source=...&target=... dans l'URL. Aucun JavaScript. *@
<form method="get" action="@Url.Action("Index")" class="toolbar">
    <label class="field">
        Source
        <input type="text" name="source" value="@Model.Source"
               placeholder="ex: N1" autocomplete="off" autofocus />
    </label>
    <label class="field">
        Cible
        <input type="text" name="target" value="@Model.Target"
               placeholder="ex: N50000" autocomplete="off" />
    </label>
    @* Menu déroulant de choix d'algorithme. name="algo" -> arrive dans
       HomeController.Index(..., string? algo, ...). L'attribut booléen
       "selected" est rendu par Razor uniquement quand l'expression vaut true,
       ce qui garde l'option choisie après le rechargement. *@
    <label class="field">
        Algorithme
        <select name="algo">
            <option value="bfs" selected="@(Model.Algo == "bfs")">BFS bidirectionnel</option>
            <option value="dijkstra" selected="@(Model.Algo == "dijkstra")">Dijkstra</option>
            <option value="dijkstra-bi" selected="@(Model.Algo == "dijkstra-bi")">Dijkstra bidirectionnel</option>
            <option value="astar" selected="@(Model.Algo == "astar")">A* (heuristique ALT)</option>
        </select>
    </label>
    <button type="submit" class="btn btn-primary">Chercher</button>
    <a href="@Url.Action("Index")" class="btn btn-ghost">Effacer</a>
</form>

@if (Model.InputError != null)
{
    <div class="banner not-found">@Model.InputError</div>
}
else if (Model.Searched)
{
    @if (!Model.Found)
    {
        <div class="banner not-found">
            ✗ Aucun chemin de « @Model.Source » vers « @Model.Target »
            @if (Model.SkippedByScc)
            {
                <text>— la condensation SCC prouve qu'aucun chemin orienté
                n'existe (verdict <strong>exact</strong>, <strong>sans BFS</strong>).</text>
            }
            else if (Model.SkippedByScan)
            {
                <text>— les deux nœuds sont dans des composantes connexes
                différentes (détecté par le scan, <strong>sans BFS</strong>).</text>
            }
            else
            {
                <text>(nœud inexistant, ou pas de chemin en 20 paliers maximum).</text>
            }
        </div>
    }
    else
    {
        <div class="banner found">
            ✓ Un chemin existe (@Model.HopCount arête@(Model.HopCount > 1 ? "s" : "")).
            @if (Model.SolvedInMemory)
            {
                <text>&nbsp;<span class="hint">— @Model.AlgoLabel sur le graphe en mémoire (§ 11.7)</span></text>
            }
        </div>

        @* --- Chaîne des nœuds : source → ... → cible ------------------- *@
        <div class="chain">
            @for (var i = 0; i < Model.Path.Count; i++)
            {
                @if (i > 0)
                {
                    <span class="arrow">→</span>
                }
                var css = i == 0 ? "chip chip-start"
                        : i == Model.Path.Count - 1 ? "chip chip-end"
                        : "chip";
                <span class="@css">@Model.Path[i]</span>
            }
        </div>

        @* --- Tableau détaillé : une ligne par arête ------------------- *@
        @if (Model.Edges.Count > 0)
        {
            <table class="edges">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>De</th>
                        <th>Vers</th>
                        <th>Transformation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var edge in Model.Edges)
                    {
                        <tr>
                            <td class="num">@edge.Index</td>
                            <td>@edge.From</td>
                            <td>@edge.To</td>
                            <td>@(edge.Transformation ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="hint">Chemin de longueur 0 : la source et la cible sont le même nœud.</p>
        }
    }

    @if (Model.FromCache)
    {
        <p class="hint">Résultat servi depuis le cache applicatif (5 min).</p>
    }
}

<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Base créée par les scripts de Sql-procedure-table.
         Server : ton instance SQL Express (.\ = cette machine, en mémoire partagée)
         Integrated Security : connexion avec ton compte Windows -->
    <add name="RestitutionGrapheProd"
         connectionString="Server=.\SQLEXPRESS01;Database=RestitutionGrapheProd;Integrated Security=True;Application Name=LineageExplorer"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Délai max d'une procédure (secondes). Une recherche de voisins par
         coordonnées incomplètes lit toute la table : ça peut dépasser 30 s. -->
    <add key="CommandTimeoutSeconds" value="300" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
